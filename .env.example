# ==========================================================
# Hotel Management Web App — Environment Variables (TEMPLATE)
# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง — ห้าม commit ไฟล์ .env
#   cp .env.example .env
# ==========================================================

# --- LINE Messaging API (OA bot) ---
# LINE Developers Console (https://developers.line.biz/console/)
# Messaging API channel > Basic settings
LINE_CHANNEL_SECRET=your_channel_secret_here
# Messaging API channel > Channel access token (long-lived)
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here
# Messaging API channel > Basic settings > Channel ID
LINE_CHANNEL_ID=your_channel_id_here

# --- LINE LIFF + LINE Login (guest web app identity) ---
# LIFF app id (LINE Login channel > LIFF)  e.g. 1234567890-abcdefg
LIFF_ID=your_liff_id_here
# LINE Login channel id (ใช้ verify id token ฝั่ง Edge Function)
LINE_LOGIN_CHANNEL_ID=your_line_login_channel_id_here

# --- Supabase ---
# Project settings > API
SUPABASE_URL=https://loxhiqsutuboxyllmysw.supabase.co
SUPABASE_ANON_KEY=your_anon_publishable_key_here
# ⚠️ SERVICE ROLE = full admin. ใช้เฉพาะฝั่ง server/Edge Function เท่านั้น
#    ห้ามใส่ในโค้ด frontend หรือ commit เด็ดขาด
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# สำหรับ Supabase CLI (Project settings > General > Reference ID)
SUPABASE_PROJECT_REF=loxhiqsutuboxyllmysw

# --- Frontend config (ค่าที่ปลอดภัยให้ frontend เห็นได้) ---
# ใช้ใน guest-app / dashboard (เฉพาะ URL + anon key เท่านั้น)
PUBLIC_SUPABASE_URL=https://loxhiqsutuboxyllmysw.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your_anon_publishable_key_here
PUBLIC_LIFF_ID=your_liff_id_here
